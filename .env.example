# ==============================================================================
# GovMesh SIH26129: Revenue & Forest Department - Environment Configuration
# ==============================================================================

# Application Environment (development / staging / production)
APP_ENV=production
DEBUG=false

# Service Metadata
PROJECT_NAME="GovMesh SIH26129 - Revenue & Forest Department System"
SERVICE_NAME=revenue-department
VERSION=0.2.0

# Server Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
DB_PORT=5432

# Backend API URL (for Frontend Portal in production)
VITE_API_URL=https://sih-2026-revenue-dept.onrender.com
VITE_API_BASE_URL=https://sih-2026-revenue-dept.onrender.com

# GovMesh Interoperability Configuration
DEPARTMENT_1_API_BASE_URL=https://sih-2026-revenue-dept.onrender.com
REVENUE_API_BASE_URL=https://sih-2026-revenue-dept.onrender.com

# PostgreSQL Database Configuration (Department Internal Database)
# (Optional: System operates on high-speed in-memory seeded fallback if DB is offline)
# The FastAPI application directly consumes DATABASE_URL via SQLAlchemy.
# For local bare-metal development with local PostgreSQL (default user: postgres):
DATABASE_URL=postgresql://postgres:<your-password>@localhost:5432/revenue_db
# For production cloud deployments (Render / AWS RDS / Supabase):
# DATABASE_URL=postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>

# Container & Docker Compose Variables (consumed by docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<your-password>
POSTGRES_DB=revenue_db

# Connection Pool & Timeout Settings (Optional, defaults: 5, 10, 5)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_TIMEOUT_SECONDS=5

# JWT & Session Security Configuration
# IMPORTANT: In production, generate a secure random 32+ byte string!
JWT_SECRET=your_secure_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
SESSION_TIMEOUT_MINUTES=30

# CORS Allowed Origins (Comma-separated list of trusted frontend origins)
CORS_ORIGINS=https://sih-26129-gov-mesh-citizen.vercel.app,http://localhost:5173,http://localhost:3000

# Transport & HTTP Security (Phase 09 Step 05)
ENABLE_HSTS=false
ENABLE_DOCS=true
ALLOWED_HOSTS=*

# Failure & Operational Simulation Mode (NONE | API_UNAVAILABLE | TIMEOUT | INTERNAL_ERROR)
FAILURE_MODE=NONE
SIMULATION_LATENCY_MS=0

# Phase 10: OCR Engine Configuration
# OCR_PROVIDER: SIMULATED (default, no dependencies) | TESSERACT (requires tesseract-ocr installed)
OCR_PROVIDER=SIMULATED
TESSERACT_CMD=
TESSERACT_LANG=eng+mar
OCR_TIMEOUT_SECONDS=15

# ==============================================================================
# Safe Demo Role Accounts (For SIH Demonstration & Internal Testing Only)
# ==============================================================================
# 1. Revenue Officer:            revenue.officer  / Officer@2026
# 2. Senior Revenue Officer:     senior.officer   / Senior@2026
# 3. Department Administrator:   revenue.admin    / Admin@2026
# 4. Read-only Auditor:          revenue.auditor  / Auditor@2026
