# ==============================================================================
# GovMesh SIH26129: Revenue & Forest Department - Environment Configuration
# ==============================================================================

# Application Environment (development / staging / production)
APP_ENV=development
DEBUG=true

# Service Metadata
PROJECT_NAME="GovMesh SIH26129 - Revenue & Forest Department System"
SERVICE_NAME=revenue-department
VERSION=0.2.0

# Server Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
DB_PORT=5432

# Backend API URL (for Frontend Portal in production)
# Leave empty for relative proxy (/api/...) or provide deployed backend origin
VITE_API_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# PostgreSQL Database Configuration (Department Internal Database)
# (Optional: System operates on high-speed in-memory seeded fallback if DB is offline)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=revenue_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/revenue_db

# JWT & Session Security Configuration (Phase 02)
# IMPORTANT: In production, generate a secure random 32+ byte string!
JWT_SECRET=dev-revenue-department-secret-key-sih26129-do-not-use-in-prod-32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
SESSION_TIMEOUT_MINUTES=30

# CORS Allowed Origins (Comma-separated list of trusted frontend origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Phase 05 Failure & Operational Simulation Mode (NONE | API_UNAVAILABLE | TIMEOUT | INTERNAL_ERROR)
FAILURE_MODE=NONE
SIMULATION_LATENCY_MS=0

# ==============================================================================
# Safe Demo Role Accounts (For SIH Demonstration & Internal Testing Only)
# ==============================================================================
# 1. Revenue Officer:            revenue.officer  / Officer@2026
# 2. Senior Revenue Officer:     senior.officer   / Senior@2026
# 3. Department Administrator:   revenue.admin    / Admin@2026
# 4. Read-only Auditor:          revenue.auditor  / Auditor@2026
